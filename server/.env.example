# Spinity Server Environment Variables

# MongoDB Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://ilyasify:ilyasify@cluster0.ypywyt2.mongodb.net/spinity?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (CHANGE IN PRODUCTION - generate with: openssl rand -base64 32)
JWT_SECRET=spinity-dev-secret-change-in-production

# CORS - What domains can access the API
CLIENT_URL=http://localhost:5173

# WebRTC STUN servers (free)
STUN_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Note: For production voice calls behind strict NATs, you'll need TURN servers
# which typically cost money. For testing behind normal NATs, STUN is fine.
